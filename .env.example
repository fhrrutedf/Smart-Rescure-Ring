# 🚑 PulseRing - Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it's in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# --- AI & Analysis ---
# Google Gemini API Key (Required for Image Analysis)
# Get it from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (Optional fallback for multiple AI models)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# --- Voice & Instructions ---
# ElevenLabs API Key (Required for High-Quality Arabic Voice)
# Get it from: https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Networking ---
# ⚙️  Internal port — 8741 is unique to PulseRing to avoid conflicts on shared VPS
# Nginx proxies public port 80 → this port internally.
PORT=8741

# For LOCAL development:  http://localhost:8741
# For Hostinger VPS:      https://yourdomain.com   (nginx handles 80 → 8741)
# For Vercel:             https://pulsering.vercel.app
EXPO_PUBLIC_API_URL=https://yourdomain.com

# --- Database ---
# PostgreSQL Connection String
# Hostinger VPS (local):  postgresql://pulsering_user:password@localhost:5432/pulsering_db
# Supabase (cloud free):  postgresql://postgres:[password]@db.xxx.supabase.co:5432/postgres
# Leave empty to use in-memory storage (data lost on restart)
DATABASE_URL=postgresql://pulsering_user:password@localhost:5432/pulsering_db
